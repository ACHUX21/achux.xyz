---
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import Rail from '../components/Rail.astro';
import Hero from '../components/Hero.astro';
import About from '../components/About.astro';
import Record from '../components/Record.astro';
import Projects from '../components/Projects.astro';
import Contact from '../components/Contact.astro';
import Command from '../components/Command.astro';
---
<Base>
  <Nav />
  <Rail />
  <main id="main">
    <Hero />
    <About />
    <Record />
    <Projects />
    <Contact />
  </main>
  <Command />
</Base>

<script>
  import { layers } from '../data/site';

  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  document.querySelectorAll('.feature').forEach((feature) => {
    if (reduce) return;
    feature.classList.add('will-animate');
    const observer = new IntersectionObserver((entries) => {
      if (entries.some((entry) => entry.isIntersecting)) feature.classList.add('is-in');
    }, { threshold: 0.15 });
    observer.observe(feature);
  });

  const layerNow = document.getElementById('layer-now');
  function markLayer() {
    const line = window.scrollY + 110;
    let current = layers[0];
    for (const layer of layers) {
      const el = document.getElementById(layer.id);
      if (!el) continue;
      const top = el.getBoundingClientRect().top + window.scrollY;
      if (top <= line) current = layer;
    }
    document.querySelectorAll('[data-section], [data-depth]').forEach((node) => {
      const id = node.getAttribute('data-section') || node.getAttribute('data-depth');
      if (id === current.id) node.setAttribute('aria-current', 'true');
      else node.removeAttribute('aria-current');
    });
    if (layerNow) layerNow.textContent = `LAYER:${current.n} ${current.name}`;
  }
  markLayer();
  document.addEventListener('scroll', markLayer, { passive: true });
  window.addEventListener('resize', markLayer);
</script>
