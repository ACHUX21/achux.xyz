---
interface Props {
  path: string;
  status: string;
  layer: string;
}
const { path, status, layer } = Astro.props;
---
<p class="proto">
  <span class="proto__req">GET {path} HTTP/1.1</span>
  <span class="proto__layer">LAYER:{layer}</span>
  <span class="proto__res">200 OK · {status}</span>
</p>
