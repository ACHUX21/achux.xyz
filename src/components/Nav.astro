---
const links = [
  { label: 'Achievements', href: '#achievements' },
  { label: 'Log', href: '#log' },
  { label: 'Skills', href: '#skills' },
  { label: 'Notes', href: '#writeups' },
  { label: 'Contact', href: '#contact' },
];
---

<header class="site-header">
  <div class="wrap header-bar">
    <a class="wordmark" href="#top">ACHUX<span>21</span></a>
    <nav aria-label="Sections">
      <ul class="nav-links">
        {
          links.map((link) => (
            <li>
              <a href={link.href} data-nav>
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
    <button
      type="button"
      class="cmd-btn"
      data-open-palette
      aria-keyshortcuts="Control+K Meta+K"
    >
      Jump
      <kbd data-kbd>Ctrl K</kbd>
    </button>
  </div>
  <div class="wrap">
    <p class="statusline">
      <span class="pulse" aria-hidden="true"></span>
      <span class="status-copy">
        currently: F1ux · hunting on Bugcrowd · Dalian<span id="dalian-clock" aria-hidden="true"></span>
      </span>
    </p>
  </div>
</header>

<script>
  const mac = /Mac|iPhone|iPad/.test(navigator.userAgent);
  document.querySelectorAll('[data-kbd]').forEach((el) => {
    el.textContent = mac ? '⌘K' : 'Ctrl K';
  });

  const clock = document.getElementById('dalian-clock');
  const format = new Intl.DateTimeFormat('en-GB', {
    timeZone: 'Asia/Shanghai',
    hour: '2-digit',
    minute: '2-digit',
    hourCycle: 'h23',
  });
  const tick = () => {
    if (clock) clock.textContent = ` · ${format.format(new Date())}`;
  };
  tick();
  window.setInterval(tick, 30_000);
</script>
