---
import { navLinks } from '../data/site';
import Icon from './Icon.astro';

const socials = [
  { label: 'GitHub', href: 'https://github.com/ACHUX21', icon: 'github' },
  { label: 'Bugcrowd', href: 'https://bugcrowd.com/h/ACH21', icon: 'bug' },
  { label: 'CTFtime', href: 'https://ctftime.org/team/417727', icon: 'ctftime' },
  { label: 'Blog', href: 'https://blog.achux.xyz', icon: 'blog' },
];
---
<a class="mark" href="/#top">A<span class="visually-hidden">CHUX21</span></a>
<div class="status">
  <p class="status__live">
    <time class="clock" id="clock" datetime="" aria-label="Current time, UTC+8">--:--:--</time>
    <span>UTC+8</span>
    <span class="layer-now" id="layer-now">LAYER:00 hero</span>
  </p>
  <button class="cli-open" id="cli-open" type="button" aria-label="Open command line">&gt;_</button>
  <button
    class="burger"
    id="nav-open"
    type="button"
    aria-expanded="false"
    aria-controls="nav-menu"
  >
    <span class="burger__bar"></span>
    <span class="burger__bar"></span>
    <span class="burger__bar"></span>
    <span class="visually-hidden">Open menu</span>
  </button>
</div>

<div class="menu" id="nav-menu" aria-hidden="true">
  <button class="menu__close" id="nav-close" type="button">Close</button>
  <nav aria-label="Sections">
    {navLinks.map((link) => (
      <a href={link.href} data-section={link.id}>{link.label}</a>
    ))}
  </nav>
  <ul class="menu__social">
    {socials.map((link) => (
      <li>
        <a href={link.href} target="_blank" rel="noopener noreferrer" aria-label={link.label}>
          <Icon name={link.icon} size={24} />
        </a>
      </li>
    ))}
  </ul>
</div>

<script is:inline>
  const menu = document.getElementById('nav-menu');
  const openBtn = document.getElementById('nav-open');
  const closeBtn = document.getElementById('nav-close');
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  function openMenu() {
    menu.classList.add('is-open');
    menu.setAttribute('aria-hidden', 'false');
    openBtn.setAttribute('aria-expanded', 'true');
    document.body.style.overflow = 'hidden';
    closeBtn.focus();
  }

  function closeMenu() {
    menu.classList.remove('is-open');
    menu.setAttribute('aria-hidden', 'true');
    openBtn.setAttribute('aria-expanded', 'false');
    document.body.style.overflow = '';
    if (document.activeElement && menu.contains(document.activeElement)) openBtn.focus();
  }

  openBtn.addEventListener('click', openMenu);
  closeBtn.addEventListener('click', closeMenu);
  menu.querySelectorAll('a').forEach((link) => {
    link.addEventListener('click', closeMenu);
  });
  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape' && menu.classList.contains('is-open')) closeMenu();
  });
  if (reduce) menu.style.transition = 'none';

  const clock = document.getElementById('clock');
  if (clock) {
    const fmt = new Intl.DateTimeFormat('en-GB', {
      timeZone: 'Asia/Shanghai',
      hour: '2-digit',
      minute: '2-digit',
      second: '2-digit',
      hourCycle: 'h23',
    });
    const tick = () => {
      const now = new Date();
      clock.textContent = fmt.format(now);
      clock.setAttribute('datetime', now.toISOString());
    };
    tick();
    setInterval(tick, 1000);
  }
</script>
