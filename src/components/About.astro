---
import SectionHead from './SectionHead.astro';
import { site } from '../data/site';
import { facts } from '../data/record';
---
<section class="whoami" id="whoami" aria-labelledby="whoami-title">
  <SectionHead path="/whoami" status="F1ux" layer="01" headingId="whoami-title">Hi there</SectionHead>
  <p class="whoami__prose">{site.about}</p>
  <p class="whoami__place">大连 · Dalian · UTC+8</p>
  <blockquote class="quote">
    <p>{site.quote}</p>
    <footer>F1ux bio · ACHUX21 · Member</footer>
  </blockquote>
  <ul class="whoami__facts">
    {facts.map((f) => (
      <li>
        <span>{f.key}</span>
        {f.href ? (
          <a href={f.href} target="_blank" rel="noopener noreferrer">{f.value}</a>
        ) : (
          <span>{f.value}</span>
        )}
      </li>
    ))}
  </ul>
</section>
