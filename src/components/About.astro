---
import { site } from '../data/site';
import { facts } from '../data/record';
---
<section class="whoami" id="whoami" aria-labelledby="whoami-title">
  <h2 id="whoami-title" class="visually-hidden">Whoami</h2>
  <p class="whoami__prose">{site.about}</p>
  <ul class="whoami__facts">
    {facts.map((f) => (
      <li>
        <span>{f.key}</span>
        {f.href ? (
          <a href={f.href} target="_blank" rel="noopener noreferrer">{f.value}</a>
        ) : (
          <span>{f.value}</span>
        )}
      </li>
    ))}
  </ul>
  <blockquote class="quote">
    <p>{site.quote}</p>
    <footer>F1ux bio · ACHUX21 · Member</footer>
  </blockquote>
</section>
