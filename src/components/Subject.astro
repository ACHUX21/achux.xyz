---
import { site } from '../data/site';
---

<section id="subject" class="section" tabindex="-1">
  <div class="wrap subject-grid">
    <header class="section-head" data-reveal>
      <p class="index"><span>00</span><i></i>Subject</p>
      <h2>Subject</h2>
      <p class="lede">{site.origin} · {site.location}</p>
    </header>
    <div class="subject-side">
      <p class="bio" data-reveal>{site.bio}</p>
      <ul class="chip-row" data-reveal>
        {site.facts.map((fact) => <li class="chip plain">{fact}</li>)}
        <li class="chip plain">Currently with <em>F1ux</em></li>
      </ul>
      <p class="quote" data-reveal>{site.taglines[1]}</p>
    </div>
  </div>
</section>
