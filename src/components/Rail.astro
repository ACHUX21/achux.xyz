---
import { navLinks, hostOf } from '../data/site';

const socials = [
  { label: 'GitHub', href: 'https://github.com/ACHUX21' },
  { label: 'Bugcrowd', href: 'https://bugcrowd.com/h/ACH21' },
  { label: 'CTFtime', href: 'https://ctftime.org/team/417727' },
  { label: 'Blog', href: 'https://blog.achux.xyz' },
];
---
<aside class="rail" aria-label="Page">
  <a class="rail__brand" href="/#top">A</a>
  <nav>
    {navLinks.map((link) => (
      <a href={link.href} data-section={link.id}>{link.label}</a>
    ))}
  </nav>
  <ul>
    {socials.map((link) => (
      <li>
        <a href={link.href} target="_blank" rel="noopener noreferrer">
          {link.label}
          <span class="out__host">{hostOf(link.href)}</span>
        </a>
      </li>
    ))}
  </ul>
</aside>
