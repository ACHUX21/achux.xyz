---
import { ctfLinks, placements, stats, teams } from '../data/ctf';
---

<section id="ctf" class="section" tabindex="-1">
  <div class="wrap">
    <header class="section-head" data-reveal>
      <p class="index"><span>02</span><i></i>Field notes</p>
      <h2>CTF & achievements</h2>
      <p class="lede">Placements with a public proof where one exists.</p>
    </header>

    <div class="stats">
      {
        stats.map((stat) => (
          <div class="glass stat" data-reveal>
            <b>{stat.value}</b>
            <span>{stat.label}</span>
          </div>
        ))
      }
    </div>

    <div class="glass panel" data-reveal>
      <h3>Placements</h3>
      {
        placements.map((item) => (
          <article class="place">
            <p class="place-rank">{item.place}</p>
            <div>
              <h3>{item.event}</h3>
              <p>
                {[item.team, item.year].filter(Boolean).join(' · ') || 'Team not listed'}
              </p>
            </div>
            {item.proof ? (
              <a class="artifact" href={item.proof.href} target="_blank" rel="noopener noreferrer">
                {item.proof.label}
              </a>
            ) : (
              <span class="quiet">—</span>
            )}
          </article>
        ))
      }

      <p class="team-label">Teams</p>
      <ul class="team-row">
        {
          teams.map((team) => (
            <li>
              {team.href ? (
                <a class="chip" href={team.href} target="_blank" rel="noopener noreferrer">
                  {team.name}
                  {team.current && <em>current</em>}
                </a>
              ) : (
                <span class="chip">{team.name}</span>
              )}
            </li>
          ))
        }
      </ul>

      <p class="team-label">Profiles</p>
      <ul class="link-row">
        {
          ctfLinks.map((link) => (
            <li>
              <a class="artifact" href={link.href} target="_blank" rel="noopener noreferrer">
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</section>
