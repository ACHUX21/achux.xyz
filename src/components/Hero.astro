---
import Protocol from './Protocol.astro';
import { site } from '../data/site';

const roles = ['Web security', 'CTF player', 'Bug hunter', 'Writeups'];
---
<section class="hero" id="top" aria-labelledby="hero-name">
  <img
    class="hero__photo"
    src="/images/plate-dalian.webp"
    width="1280"
    height="720"
    alt="Utility poles and sagging power lines over a residential street in Dalian at dusk. One apartment window is lit. No people."
    fetchpriority="high"
    decoding="async"
  />
  <div class="hero__noise" aria-hidden="true"></div>
  <div class="hero__shade" aria-hidden="true"></div>
  <div class="hero__copy">
    <Protocol path="/" layer="00" />
    <p class="hero__meta">
      <span>18:40</span>
      <span>大连 · Dalian</span>
    </p>
    <h1 class="hero__name" id="hero-name">{site.name}</h1>
    <p class="role" data-roles={roles.join('|')}>
      <span id="role-word">{roles[0]}</span>
    </p>
    <p class="hero__line">{site.line}</p>
  </div>
</section>

<script>
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const word = document.getElementById('role-word');
  const roles = (word?.parentElement?.getAttribute('data-roles') || '').split('|').filter(Boolean);

  if (word && !reduce && roles.length > 1) {
    const alphabet = 'ABCDEFGHIJKLMNOPQRSTUVWXYZ';
    let index = 0;
    const reveal = (next: string) => {
      let step = 0;
      const timer = setInterval(() => {
        step += 1;
        if (step < 6) {
          word.textContent = next
            .split('')
            .map((char, i) => (i < step - 1 || char === ' ' ? char : alphabet[Math.floor(Math.random() * alphabet.length)]!))
            .join('');
        } else {
          word.textContent = next;
          clearInterval(timer);
        }
      }, 40);
    };
    setInterval(() => {
      index = (index + 1) % roles.length;
      reveal(roles[index]!);
    }, 2800);
  }
</script>
