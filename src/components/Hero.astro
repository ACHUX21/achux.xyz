---
import Figure from './Figure.astro';
import Plate from './Plate.astro';
import { site } from '../data/site';
---
<section class="hero" id="top" aria-labelledby="hero-name">
  <p class="hero__chrome chrome">LAYER:00</p>
  <div class="hero__copy">
    <p class="eyebrow">
      <span class="signal" aria-hidden="true"></span>
      <span>present day · present time · Dalian, CN · UTC+8</span>
      <time class="clock" id="clock" aria-label="Current time, UTC+8">--:--:--</time>
    </p>
    <h1 class="hero__name" id="hero-name">{site.name}</h1>
    <p class="hero__role">{site.line}</p>
    <p class="hero__tag">{site.tagline}</p>
    <a class="btn" href="/resume.pdf">Resume</a>
    <p class="hero__status">
      eJPTv2 · 3 national CTF wins · $2,150 high on Viator · <a href="mailto:21@achux.xyz">21@achux.xyz</a> · <a href="https://github.com/ACHUX21">GitHub</a>
    </p>
  </div>
  <Plate
    class="hero__plate"
    src="/images/plate-dalian.webp"
    width={1280}
    height={720}
    loading="eager"
    caption="plate 01 · dalian · 18:40"
    alt="Utility poles and sagging power lines over a residential street in Dalian at dusk. One apartment window is lit. No people."
  />
  <Figure />
</section>

<script>
  const clock = document.getElementById('clock');
  if (clock) {
    const fmt = new Intl.DateTimeFormat('en-GB', {
      timeZone: 'Asia/Shanghai',
      hour: '2-digit',
      minute: '2-digit',
      second: '2-digit',
      hourCycle: 'h23',
    });
    const tick = () => {
      const now = new Date();
      clock.textContent = fmt.format(now);
      clock.setAttribute('datetime', now.toISOString());
    };
    tick();
    setInterval(tick, 1000);
  }
</script>
