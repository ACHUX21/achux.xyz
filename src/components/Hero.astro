---
import Protocol from './Protocol.astro';
import { site } from '../data/site';
---
<section class="hero" id="top" aria-labelledby="hero-name">
  <img
    class="hero__photo"
    src="/images/plate-dalian.webp"
    width="1280"
    height="720"
    alt="Utility poles and sagging power lines over a residential street in Dalian at dusk. One apartment window is lit. No people."
    fetchpriority="high"
    decoding="async"
  />
  <div class="hero__noise" aria-hidden="true"></div>
  <div class="hero__shade" aria-hidden="true"></div>
  <div class="hero__copy">
    <Protocol path="/" status="Dalian" layer="00" />
    <p class="hero__meta">
      <span>plate 01 · dalian · 18:40</span>
    </p>
    <h1 class="hero__name" id="hero-name">{site.name}</h1>
    <p class="hero__line">{site.line}</p>
  </div>
</section>
