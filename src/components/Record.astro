---
import SectionHead from './SectionHead.astro';
import { site, hostOf } from '../data/site';
import {
  placements,
  prizeNote,
  bounties,
  undatedMarks,
  teams,
} from '../data/record';

const placeMarks = placements
  .filter((p) => p.place.startsWith('1st') || p.place.startsWith('2nd'))
  .map((p) => ({
    word: p.place.startsWith('2nd') ? '2nd' : p.place,
    meta: p.place.startsWith('2nd')
      ? `open division · ${p.event} · ${p.team} · ${p.date}`
      : `${p.event} · ${p.team} · ${p.date}`,
    prize: p.prize,
  }));
const htb = placements.find((p) => p.place.startsWith('14'))!;
const viator = bounties[0];
const p4 = bounties[1];
---
<section class="record" id="record" aria-labelledby="record-title">
  <SectionHead path="/record" layer="02" headingId="record-title">Record</SectionHead>
  <div class="feature">
    <div class="feature__copy">
      <p>Three firsts in 2025 with PLOTONEA. Second in the Cyber Odyssey 2024 open division with L3AK MA.</p>
      <a class="btn" href="#record-marks">Placements</a>
    </div>
    <div class="screen" id="record-marks">
      <ul class="places">
        {placeMarks.map((p) => (
          <li>
            <span class="giant__num">{p.word}</span>
            <span class="giant__meta">{p.meta}</span>
            {p.prize && <span class="amount">{p.prize}</span>}
          </li>
        ))}
      </ul>
      <p class="minor">{htb.place} · {htb.event} · {htb.team} · {htb.date}</p>
      <p class="fine">{prizeNote}</p>
    </div>
  </div>

  <p class="authored">
    <span class="authored__k">Authored</span>
    Co-authored the L3akCTF web challenge <a href="https://kashmir54.github.io/ctfs/L3akCTF2024/" target="_blank" rel="noopener noreferrer">PEPE</a> with S1mple, and wrote and hosted the web challenges for GCDSTE Secure Tech × 0xNox, Dec 2024.
  </p>
  <p class="btn-line">
    <a class="btn" href="https://blog.achux.xyz" target="_blank" rel="noopener noreferrer">All writeups</a>
    <span class="out__host">blog.achux.xyz</span>
  </p>
  <div class="line">
    <ul class="undated">
      {undatedMarks.map((m) => (
        <li>
          <span>{m.title}</span>
          {m.note && <span> · {m.note}</span>}
        </li>
      ))}
    </ul>
  </div>

  <ul class="teams">
    {teams.map((t) => (
      <li>
        <span class="teams__name">{t.name}</span>
        <span>{t.status}</span>
        {t.links?.map((l) => (
          <a class="with-host" href={l.href} target="_blank" rel="noopener noreferrer">
            <span>{l.label}</span>
            <span class="out__host">{hostOf(l.href)}</span>
          </a>
        ))}
      </li>
    ))}
  </ul>
</section>

<section class="bugs" id="bugs" aria-labelledby="bugs-title">
  <SectionHead path="/bugs" status="ACH21" layer="03" headingId="bugs-title">Bugs</SectionHead>
  <ul class="pair">
    <li>
      <h3>Viator <span>{viator.severity}</span></h3>
      <p>Bugcrowd ACH21</p>
      <p>accepted {viator.accepted}</p>
      <p>{site.bountyIntro}</p>
      <p class="amount">{viator.award}</p>
      {viator.profile && <a class="btn" href={viator.profile}>Bugcrowd profile</a>}
    </li>
    <li>
      <h3>{p4.program} <span>{p4.severity}</span></h3>
      <p>{p4.note}</p>
      <p class="amount">{p4.award}</p>
    </li>
  </ul>
</section>
