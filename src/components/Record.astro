---
import { site } from '../data/site';
import {
  placements,
  prizeNote,
  bounties,
  timeline,
  timelineYears,
  undatedMarks,
  teams,
} from '../data/record';

const odyssey = placements.find((p) => p.event.startsWith('Cyber Odyssey'))!;
const firsts = placements.filter((p) => p.place === '1st');
const htb = placements.find((p) => p.place.startsWith('14'))!;
const viator = bounties[0];
const p4 = bounties[1];
const byYear = timelineYears.map((year) => ({
  year,
  marks: timeline.filter((m) => m.year === year),
}));
---
<section class="record" id="record" aria-labelledby="record-title">
  <h2 id="record-title" class="visually-hidden">Record</h2>

  <div class="marks">
    <div class="marks__giants">
      <p class="giant">
        <span class="giant__num">{odyssey.prize}</span>
        <span class="giant__meta">{odyssey.place} · {odyssey.event} · {odyssey.team} · {odyssey.date}</span>
      </p>
      <p class="giant">
        <span class="giant__num">{viator.award.replace(' USD', '')}</span>
        <span class="giant__meta">{viator.program} · {viator.severity} · {viator.accepted}</span>
      </p>
    </div>
    <p class="fine">{prizeNote}</p>
    <ul class="firsts">
      {firsts.map((p) => (
        <li>
          <span class="firsts__num">{p.prize}</span>
          <span>{p.place} · {p.event} · {p.team} · {p.date}</span>
        </li>
      ))}
    </ul>
    <p class="minor">{htb.place} · {htb.event} · {htb.team} · {htb.date}</p>
    <p class="minor">{p4.severity} · {p4.award} · {p4.program}. {p4.note}</p>
    <p class="honest">{site.bountyIntro}</p>
    {viator.note && <p class="fine">{viator.note}</p>}
    {viator.asset && (
      <p class="fine">
        <a href={viator.asset}>{viator.asset}</a>
        {viator.profile && <> · <a href={viator.profile}>{viator.profileLabel}</a></>}
        {viator.source && <> · <a href={viator.source}>{viator.sourceLabel}</a></>}
      </p>
    )}
  </div>

  <div class="line">
    <svg class="line__wire" viewBox="0 0 1200 36" preserveAspectRatio="none" aria-hidden="true">
      <path d="M0 8 C 160 8, 220 30, 400 24 S 720 4, 920 18 S 1100 32, 1200 12" />
    </svg>
    <div class="line__years">
      {byYear.map((col) => (
        <div>
          <h3>{col.year}</h3>
          <ol>
            {col.marks.map((m) => (
              <li>
                <time>{m.when}</time>
                {m.href ? (
                  <a href={m.href} target="_blank" rel="noopener noreferrer">{m.title}</a>
                ) : (
                  <span>{m.title}</span>
                )}
                {m.title.startsWith('1337') && (
                  <>
                    {' '}
                    <a href="https://blog.achux.xyz" target="_blank" rel="noopener noreferrer">blog</a>
                  </>
                )}
              </li>
            ))}
          </ol>
        </div>
      ))}
    </div>
    <ul class="undated">
      {undatedMarks.map((m) => (
        <li>
          <span>{m.title}</span>
          <span>{m.note}</span>
        </li>
      ))}
    </ul>
  </div>

  <ul class="teams">
    {teams.map((t) => (
      <li>
        <span class="teams__name">{t.name}</span>
        <span>{t.status}</span>
        {t.links?.map((l) => (
          <a href={l.href} target="_blank" rel="noopener noreferrer">{l.label}</a>
        ))}
      </li>
    ))}
  </ul>
</section>
