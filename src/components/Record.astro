---
import Protocol from './Protocol.astro';
import { site, hostOf } from '../data/site';
import {
  placements,
  prizeNote,
  bounties,
  timeline,
  timelineYears,
  undatedMarks,
  teams,
  ctfCount,
} from '../data/record';

const placeMarks = placements
  .filter((p) => p.place.startsWith('1st') || p.place.startsWith('2nd'))
  .map((p) => ({
    word: p.place.startsWith('2nd') ? '2nd' : p.place,
    meta: p.place.startsWith('2nd')
      ? `open division · ${p.event} · ${p.team} · ${p.date}`
      : `${p.event} · ${p.team} · ${p.date}`,
    prize: p.prize,
  }));
const htb = placements.find((p) => p.place.startsWith('14'))!;
const viator = bounties[0];
const p4 = bounties[1];
const byYear = timelineYears.map((year) => ({
  year,
  marks: timeline.filter((m) => m.year === year),
}));
---
<section class="record" id="record" aria-labelledby="record-title">
  <Protocol path="/record" status={`${ctfCount} events`} layer="02" />
  <h2 id="record-title" class="visually-hidden">Record</h2>

  <div class="marks">
    <ul class="places">
      {placeMarks.map((p) => (
        <li>
          <span class="giant__num">{p.word}</span>
          <span class="giant__meta">{p.meta}</span>
          {p.prize && <span class="amount">{p.prize}</span>}
        </li>
      ))}
    </ul>
    <p class="minor">{htb.place} · {htb.event} · {htb.team} · {htb.date}</p>
    <p class="fine">{prizeNote}</p>

    <ul class="findings">
      <li>
        <span class="finding__title">Viator <span>{viator.severity}</span></span>
        <span class="giant__meta">Bugcrowd ACH21 · accepted {viator.accepted}</span>
        <span class="amount">{viator.award}</span>
      </li>
      <li>
        <span class="finding__title">{p4.program} <span>{p4.severity}</span></span>
        {p4.note && <span class="giant__meta">{p4.note}</span>}
        <span class="amount">{p4.award}</span>
      </li>
    </ul>
    <p class="honest">{site.bountyIntro}</p>
    {viator.asset && (
      <p class="fine">
        <a href={viator.asset}>{viator.asset}</a>
        {viator.profile && <> · <a href={viator.profile}>{viator.profileLabel}</a></>}
      </p>
    )}
  </div>

  <div class="line">
    <svg class="line__wire" viewBox="0 0 1200 36" preserveAspectRatio="none" aria-hidden="true">
      <path d="M0 8 C 160 8, 220 30, 400 24 S 720 4, 920 18 S 1100 32, 1200 12" />
    </svg>
    <div class="line__years">
      {byYear.map((col) => (
        <div>
          <h3 class:list={{ 'is-now': col.year === '2026' }}>{col.year}</h3>
          <ol>
            {col.marks.map((m) => (
              <li>
                <time>{m.when}</time>
                {m.href ? (
                  <a href={m.href} target="_blank" rel="noopener noreferrer">{m.title} <span class="out__host">{hostOf(m.href)}</span></a>
                ) : (
                  <span>{m.title}</span>
                )}
                {m.title.startsWith('1337') && (
                  <>
                    {' '}
                    <a href="https://blog.achux.xyz" target="_blank" rel="noopener noreferrer">blog</a>
                  </>
                )}
                {m.amount && <span class="amount">{m.amount}</span>}
              </li>
            ))}
          </ol>
        </div>
      ))}
    </div>
    <ul class="undated">
      {undatedMarks.map((m) => (
        <li>
          <span>{m.title}</span>
          <span>
            {m.note}
            {m.amount && <span class="amount">{m.amount}</span>}
          </span>
        </li>
      ))}
    </ul>
  </div>

  <ul class="teams">
    {teams.map((t) => (
      <li>
        <span class="teams__name">{t.name}</span>
        <span>{t.status}</span>
        {t.links?.map((l) => (
          <a href={l.href} target="_blank" rel="noopener noreferrer">{l.label} <span class="out__host">{hostOf(l.href)}</span></a>
        ))}
      </li>
    ))}
  </ul>
</section>
