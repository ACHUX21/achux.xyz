---
import { site } from '../data/site';
import {
  placements,
  prizeNote,
  authored,
  firstBlood,
  teams,
  ctfLog,
  ctfTimeTeam,
  writeupEventsBeyondLog,
  ctfCount,
  writeupsLead,
  writeups,
  localCtfWriteups,
  writeupCount,
  bounties,
} from '../data/record';

const firsts = placements.filter((p) => p.place.startsWith('1st')).length;
---
<section class="layer record" id="record" aria-labelledby="record-title">
  <p class="chrome">LAYER:02 <span>/record</span></p>
  <div class="layer__main">
    <h2 id="record-title">Record</h2>
    <p class="prose">{site.recordIntro}</p>

    <dl class="figures">
      <div>
        <dt>writeups</dt>
        <dd>{writeupCount}</dd>
      </div>
      <div>
        <dt>ctfs</dt>
        <dd>{ctfCount}</dd>
      </div>
      <div>
        <dt>bounties</dt>
        <dd>{bounties.length}</dd>
        <p class="fine">Viator high, and one unpublished P4</p>
      </div>
      <div>
        <dt>firsts</dt>
        <dd>{firsts}</dd>
        <p class="fine">2025, with PLOTONEA</p>
      </div>
    </dl>
    <p class="fine figures-note">
      {ctfCount} distinct events: {placements.length} placements, {writeupEventsBeyondLog.length} more named in the writeups
      ({writeupEventsBeyondLog.join(', ')}), and {ctfLog.length} on the <a href={ctfTimeTeam}>ACHUX21 CTFtime log</a>.
    </p>

    <h3 class="block-label">Placements</h3>
    <table class="log log--place">
      <caption>{prizeNote}</caption>
      <tbody>
        {placements.map((p) => (
          <tr>
            <th scope="row">{p.place}</th>
            <td>{p.event}</td>
            <td class="team">{p.team}</td>
            <td class="when">{p.date}</td>
            <td class="prize">{p.prize ?? ''}</td>
          </tr>
        ))}
      </tbody>
    </table>

    <h3 class="block-label">Bounties</h3>
    <p class="prose">{site.bountyIntro}</p>
    <ul class="bounty-list">
      {bounties.map((b) => (
        <li>
          <div class="bounty-list__head">
            <h4>{b.program}</h4>
            <p class="bounty-list__award">{b.severity} · {b.award}</p>
          </div>
          <dl class="kv">
            {b.asset && (
              <div>
                <dt>asset</dt>
                <dd><a href={b.asset}>{b.asset}</a></dd>
              </div>
            )}
            {b.state && (
              <div>
                <dt>state</dt>
                <dd>{b.state}</dd>
              </div>
            )}
            {b.accepted && (
              <div>
                <dt>accepted</dt>
                <dd>{b.accepted}</dd>
              </div>
            )}
            {b.profile && (
              <div>
                <dt>profile</dt>
                <dd><a href={b.profile}>{b.profileLabel}</a></dd>
              </div>
            )}
            {b.source && (
              <div>
                <dt>source</dt>
                <dd><a href={b.source}>{b.sourceLabel}</a></dd>
              </div>
            )}
          </dl>
          {b.note && <p class="note">{b.note}</p>}
        </li>
      ))}
    </ul>

    <h3 class="block-label">Challenges</h3>
    <ul class="credits">
      {authored.map((c) => (
        <li>
          <h4>{c.event}</h4>
          <p>{c.detail}</p>
          {c.note && <p class="note">{c.note}</p>}
          {c.href && (
            <a class="rowlink" href={c.href} target="_blank" rel="noopener noreferrer">{c.hrefLabel} →</a>
          )}
        </li>
      ))}
    </ul>

    <h3 class="block-label">Teams</h3>
    <ul class="teams">
      {teams.map((t) => (
        <li>
          <span class="teams__name">{t.name}</span>
          <span class="teams__status">{t.status}</span>
          <span class="teams__links">
            {t.links?.map((l) => (
              <a href={l.href} target="_blank" rel="noopener noreferrer">{l.label}</a>
            ))}
          </span>
        </li>
      ))}
    </ul>

    <div class="writeups">
      <h3>Writeups · {writeupCount}</h3>
      <p class="fine writeups__lead">
        PearlCTF and the UofTCTF post (FFmpeg injection and cache deception) lead.
        The {localCtfWriteups.length} same-day 1337 Local CTF posts are grouped after the rest.
      </p>
      {[...writeupsLead, ...writeups].map((w) => (
        <a href={w.href} target="_blank" rel="noopener noreferrer">
          <time datetime={w.date}>{w.date}</time>
          <span>{w.title}</span>
        </a>
      ))}
      <div class="writeups__group">
        <h4>1337 Local CTF · {localCtfWriteups.length} posts · 27 Jun 2026</h4>
        <p class="note">
          {firstBlood.text} <a href={firstBlood.href}>Writeup on the blog</a>.
        </p>
        {localCtfWriteups.map((w) => (
          <a href={w.href} target="_blank" rel="noopener noreferrer">
            <time datetime={w.date}>{w.date}</time>
            <span>{w.title}</span>
          </a>
        ))}
      </div>
    </div>
  </div>
</section>
