---
import { skills } from '../data/skills';
---

<section id="skills" class="section" tabindex="-1">
  <div class="wrap">
    <header class="section-head" data-reveal>
      <p class="index"><span>03</span><i></i>Kit</p>
      <h2>Skills</h2>
    </header>
    <div class="skill-grid">
      {
        skills.map((group) => (
          <div class="tilt-scene" data-reveal>
            <article class="glass skill" data-tilt="5">
              <h3>{group.category}</h3>
              <ul class="tags">
                {group.items.map((item) => (
                  <li class="chip">{item}</li>
                ))}
              </ul>
            </article>
          </div>
        ))
      }
    </div>
  </div>
</section>
