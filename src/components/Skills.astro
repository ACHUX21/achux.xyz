---
import { skills } from '../data/skills';
---
<section class="layer stack" id="stack" aria-labelledby="stack-title">
  <p class="chrome">LAYER:04 <span>/stack</span></p>
  <div class="layer__main">
    <h2 id="stack-title">Stack</h2>
    <dl class="spec">
      {skills.map((group) => (
        <div>
          <dt>{group.category}</dt>
          <dd>{group.items.join(', ')}</dd>
        </div>
      ))}
    </dl>
  </div>
</section>
