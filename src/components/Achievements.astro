---
import { getImage, Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { bounty, credentials, headlineStats, wins, type Shot } from '../data/achievements';

const modules = import.meta.glob('../assets/achievements/*.webp', {
  eager: true,
  import: 'default',
}) as Record<string, ImageMetadata>;

async function loadShots(shots: Shot[]) {
  const ready: { src: ImageMetadata; full: string; alt: string }[] = [];
  for (const shot of shots) {
    const src = modules[`../assets/achievements/${shot.file}`];
    if (!src) continue;
    const full = await getImage({ src, width: 1600, format: 'webp', quality: 78 });
    ready.push({ src, full: full.src, alt: shot.alt });
  }
  return ready;
}

const cards = await Promise.all(wins.map(async (win) => ({ win, shots: await loadShots(win.images) })));
const gold = cards.filter((card) => card.win.tone === 'gold');
const rest = cards.filter((card) => card.win.tone !== 'gold');
---

<section id="achievements" class="section achievements" tabindex="-1">
  <div class="wrap">
    <header class="section-head" data-reveal>
      <p class="index"><span>01</span><i></i>Record</p>
      <h2>Achievements</h2>
      <p class="lede">Bug bounty results and CTF placements, with the photo from each public post.</p>
    </header>

    <div class="stat-row">
      {
        headlineStats.map((stat) => (
          <article class="glass stat-tile" data-reveal>
            <b>{stat.value}</b>
            <span>{stat.label}</span>
          </article>
        ))
      }
    </div>

    <article class="glass bounty-card" data-reveal>
      <div class="bounty-glow" aria-hidden="true"></div>
      <div class="card-kicker">
        <span class="mark" aria-hidden="true">
          <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.6">
            <path d="M12 4.5a3 3 0 0 0-3 3V9H7.5A2.5 2.5 0 0 0 5 11.5V14a5 5 0 0 0 5 5h4a5 5 0 0 0 5-5v-2.5A2.5 2.5 0 0 0 16.5 9H15V7.5a3 3 0 0 0-3-3Z" />
            <path d="M9 6 7 4M15 6l2-2M5 13H3M21 13h-2M8 19l-1.5 2M16 19l1.5 2" />
          </svg>
        </span>
        <p>Bug bounty · {bounty.program}</p>
      </div>
      <p class="bounty-reward">{bounty.reward}</p>
      <h3>{bounty.name}</h3>
      <p class="kicker">{bounty.asset}</p>
      <ul class="chip-row">
        <li class="chip">Severity: <em>{bounty.severity}</em></li>
        <li class="chip">Status: <em>{bounty.status}</em></li>
        <li class="chip">Accepted: <em>{bounty.accepted}</em></li>
      </ul>
      <p class="bounty-copy">{bounty.summary}</p>
      <ul class="badge-row">
        {bounty.badges.map((badge) => <li class="badge">{badge}</li>)}
      </ul>
      <div class="artifacts">
        {
          bounty.links.map((link) => (
            <a class="artifact" href={link.href} target="_blank" rel="noopener noreferrer">{link.label}</a>
          ))
        }
      </div>
    </article>

    <div class="win-grid">
      {
        gold.map(({ win, shots }) => (
          <article class="glass win-card" data-reveal>
            {
              shots[0] ? (
                <button
                  type="button"
                  class="win-cover"
                  data-gallery={JSON.stringify(shots.map((shot) => ({ src: shot.full, alt: shot.alt })))}
                  aria-label={`View ${shots.length} photo${shots.length === 1 ? '' : 's'} from ${win.event}`}
                >
                  <Image src={shots[0].src} alt="" widths={[480, 800]} sizes="(max-width: 700px) 100vw, 360px" />
                  <span class="win-shade" aria-hidden="true"></span>
                  <span class="win-count">{shots.length} photo{shots.length === 1 ? '' : 's'}</span>
                </button>
              ) : (
                <div class="win-placeholder">
                  <span>No public photo</span>
                </div>
              )
            }
            <div class="win-meta">
              <span class={`medal medal-${win.tone}`}>{win.place}</span>
              <div>
                <h3>{win.event}</h3>
                <p>{win.team}{win.year ? ` · ${win.year}` : ''}</p>
              </div>
            </div>
            {win.proof && (
              <a class="proof" href={win.proof} target="_blank" rel="noopener noreferrer">LinkedIn post</a>
            )}
          </article>
        ))
      }
    </div>

    <div class="win-row">
      {
        rest.map(({ win, shots }) => (
          <article class="glass win-card" data-reveal>
            {
              shots[0] ? (
                <button
                  type="button"
                  class="win-cover"
                  data-gallery={JSON.stringify(shots.map((shot) => ({ src: shot.full, alt: shot.alt })))}
                  aria-label={`View ${shots.length} photo${shots.length === 1 ? '' : 's'} from ${win.event}`}
                >
                  <Image src={shots[0].src} alt="" widths={[640, 1000]} sizes="(max-width: 700px) 100vw, 520px" />
                  <span class="win-shade" aria-hidden="true"></span>
                  <span class="win-count">{shots.length} photo{shots.length === 1 ? '' : 's'}</span>
                </button>
              ) : (
                <div class="win-placeholder">
                  <span>No public photo</span>
                </div>
              )
            }
            <div class="win-meta">
              <span class={`medal medal-${win.tone}`}>{win.place}</span>
              <div>
                <h3>{win.event}</h3>
                <p>{win.team}{win.year ? ` · ${win.year}` : ''}</p>
              </div>
            </div>
            {win.proof && (
              <a class="proof" href={win.proof} target="_blank" rel="noopener noreferrer">LinkedIn post</a>
            )}
          </article>
        ))
      }
    </div>

    <div class="cred-row">
      {
        credentials.map((item) => (
          <article class="glass cred" data-reveal>
            <p class="field-label">{item.kicker}</p>
            <h3>{item.title}</h3>
            <p>{item.detail}</p>
            {item.href && (
              <a class="artifact" href={item.href} target="_blank" rel="noopener noreferrer">CTFtime</a>
            )}
          </article>
        ))
      }
    </div>
  </div>

  <dialog id="win-lightbox" class="lightbox">
    <div class="lightbox-bar">
      <button type="button" class="lb-nav" data-prev>Previous</button>
      <button type="button" data-close>Close</button>
    </div>
    <figure>
      <img alt="" />
      <figcaption></figcaption>
    </figure>
    <div class="lightbox-bar">
      <button type="button" class="lb-nav" data-next>Next</button>
    </div>
  </dialog>
</section>

<script>
  const dialog = document.querySelector<HTMLDialogElement>('#win-lightbox');
  const img = dialog?.querySelector('img');
  const caption = dialog?.querySelector('figcaption');
  let frames: { src: string; alt: string }[] = [];
  let index = 0;

  function show(next: number) {
    if (!img || !caption || !frames.length) return;
    index = (next + frames.length) % frames.length;
    const frame = frames[index];
    img.src = frame.src;
    img.alt = frame.alt;
    caption.textContent = frames.length > 1 ? `${frame.alt} (${index + 1} / ${frames.length})` : frame.alt;
  }

  document.querySelectorAll<HTMLButtonElement>('[data-gallery]').forEach((button) => {
    button.addEventListener('click', () => {
      frames = JSON.parse(button.dataset.gallery || '[]');
      show(0);
      dialog?.showModal();
    });
  });

  dialog?.querySelector('[data-close]')?.addEventListener('click', () => dialog.close());
  dialog?.querySelector('[data-prev]')?.addEventListener('click', () => show(index - 1));
  dialog?.querySelector('[data-next]')?.addEventListener('click', () => show(index + 1));
  dialog?.addEventListener('click', (event) => {
    if (event.target === dialog) dialog.close();
  });
  dialog?.addEventListener('keydown', (event) => {
    if (event.key === 'ArrowRight') show(index + 1);
    if (event.key === 'ArrowLeft') show(index - 1);
  });
</script>
