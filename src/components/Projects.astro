---
import { projects } from '../data/projects';
---
<section class="layer work" id="work" aria-labelledby="work-title">
  <p class="chrome">LAYER:03 <span>/work</span></p>
  <div class="layer__main">
    <h2 id="work-title">Work</h2>
    <ul class="rows">
      {projects.map((p) => (
        <li class:list={{ 'is-feature': p.featured }}>
          <h3>
            {p.name}
            {p.private && <span class="badge">private</span>}
          </h3>
          <div>
            <p>{p.blurb}</p>
            <p class="stackline">{p.stack}</p>
          </div>
          <div>
            {p.repo && (
              <a class="rowlink" href={p.repo} target="_blank" rel="noopener noreferrer">code →</a>
            )}
            {p.live && (
              <a class="rowlink" href={p.live} target="_blank" rel="noopener noreferrer">site →</a>
            )}
          </div>
        </li>
      ))}
    </ul>
  </div>
</section>
