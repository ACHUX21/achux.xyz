---
import SectionHead from './SectionHead.astro';
import { hostOf } from '../data/site';
import { projects } from '../data/projects';
import { cases } from '../data/cases';

function hexRows(text: string) {
  const lines = text.split('\n');
  let offset = 0;
  return lines.map((line) => {
    const row = { off: offset.toString(16).padStart(4, '0'), line };
    offset += new TextEncoder().encode(line).length + 1;
    return row;
  });
}

const featured = projects.find((project) => project.featured)!;
const rest = projects.filter((project) => !project.featured);
---
<section class="work" id="work" aria-labelledby="work-title">
  <SectionHead path="/work" status={`${projects.length} projects`} layer="04" headingId="work-title">{featured.name}</SectionHead>
  <p class="work__blurb">{featured.blurb}</p>
  {featured.repo && (
    <p class="btn-line">
      <a class="btn" href={featured.repo} target="_blank" rel="noopener noreferrer">Code</a>
      <span class="out__host">{hostOf(featured.repo)}</span>
    </p>
  )}
  <ul class="projects">
    {rest.map((p) => (
      <li>
        <h3>
          {p.name}
          {p.private && <span class="badge">private</span>}
        </h3>
        <p>{p.blurb}</p>
        <p class="projects__stack">{p.stack}</p>
        <p class="projects__links">
          {p.repo && (
            <a class="with-host" href={p.repo} target="_blank" rel="noopener noreferrer">
              <span>code</span>
              <span class="out__host">{hostOf(p.repo)}</span>
            </a>
          )}
          {p.live && (
            <a class="with-host" href={p.live} target="_blank" rel="noopener noreferrer">
              <span>site</span>
              <span class="out__host">{hostOf(p.live)}</span>
            </a>
          )}
        </p>
      </li>
    ))}
  </ul>
</section>

<section class="writeups" id="writeups" aria-labelledby="writeups-title">
  <SectionHead path="/writeups" status={`${cases.length} requests`} layer="05" headingId="writeups-title">Writeups</SectionHead>
  <div class="cases">
    {cases.map((c) => (
      <article class="case">
        <header>
          <p>{c.event}</p>
          <h3>
            <a href={c.href} target="_blank" rel="noopener noreferrer">{c.title}</a>
          </h3>
          <p class="out__host">{hostOf(c.href)}</p>
        </header>
        <div class="hex">
          {hexRows(c.request).map((row) => (
            <div>
              <span>{row.off}</span>
              <code>{row.line || ' '}</code>
            </div>
          ))}
        </div>
        <p class="case__reached">{c.reached}</p>
      </article>
    ))}
  </div>
</section>
