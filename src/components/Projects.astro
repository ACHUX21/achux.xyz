---
import Protocol from './Protocol.astro';
import { hostOf } from '../data/site';
import { projects } from '../data/projects';
import { cases } from '../data/cases';

function hexRows(text: string) {
  const lines = text.split('\n');
  let offset = 0;
  return lines.map((line) => {
    const row = { off: offset.toString(16).padStart(4, '0'), line };
    offset += new TextEncoder().encode(line).length + 1;
    return row;
  });
}

const featured = projects.find((project) => project.featured)!;
const rest = projects.filter((project) => !project.featured);
---
<section class="work" id="work" aria-labelledby="work-title">
  <div class="feature feature--flip">
    <div class="screen">
      <p class="screen__label">{featured.stack}</p>
      <p class="finding__title">{featured.name}</p>
    </div>
    <div class="feature__copy">
      <Protocol path="/work" status={`${projects.length} projects`} layer="03" />
      <p class="feature__index">03</p>
      <h2 id="work-title">{featured.name}</h2>
      <p>{featured.blurb}</p>
      {featured.repo && (
        <a class="btn" href={featured.repo} target="_blank" rel="noopener noreferrer">Code</a>
      )}
    </div>
  </div>
  <ul class="projects">
    {rest.map((p) => (
      <li>
        <h3>
          {p.name}
          {p.private && <span class="badge">private</span>}
        </h3>
        <p>{p.blurb}</p>
        <p class="projects__stack">{p.stack}</p>
        <p class="projects__links">
          {p.repo && (
            <a href={p.repo} target="_blank" rel="noopener noreferrer">code <span class="out__host">{hostOf(p.repo)}</span></a>
          )}
          {p.live && (
            <a href={p.live} target="_blank" rel="noopener noreferrer">site <span class="out__host">{hostOf(p.live)}</span></a>
          )}
        </p>
      </li>
    ))}
  </ul>

  <div class="cases">
    <div class="feature__copy">
      <p class="feature__index">04</p>
      <h3 class="cases__label">Writeups</h3>
    </div>
    {cases.map((c, i) => (
      <article class:list={['case', i === 1 && 'case--flip']}>
        <header>
          <p>{c.event}</p>
          <h3>
            <a href={c.href} target="_blank" rel="noopener noreferrer">{c.title}</a>
          </h3>
          <p class="out__host">{hostOf(c.href)}</p>
        </header>
        <div class="hex">
          {hexRows(c.request).map((row) => (
            <div>
              <span>{row.off}</span>
              <code>{row.line || ' '}</code>
            </div>
          ))}
        </div>
        <p class="case__reached">{c.reached}</p>
      </article>
    ))}
  </div>
</section>
