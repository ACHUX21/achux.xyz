---
import Icon from './Icon.astro';
import { profiles, site, socials } from '../data/site';

const year = new Date().getFullYear();
const extras = [
  { label: 'Blog', href: profiles.blog },
  { label: 'Bugcrowd', href: profiles.bugcrowd },
  { label: 'F1ux', href: profiles.f1ux },
];
---

<section id="contact" class="section contact" tabindex="-1">
  <div class="wrap">
    <header class="section-head" data-reveal>
      <p class="index"><span>05</span><i></i>Channel</p>
      <h2>Let&rsquo;s build or break something.</h2>
    </header>
    <div data-reveal>
      <a class="mail" href={`mailto:${site.email}`}>{site.email}</a>
      <ul class="socials">
        {
          socials.map((social) => (
            <li>
              <a
                class="glass"
                href={social.href}
                target={social.href.startsWith('mailto:') ? undefined : '_blank'}
                rel={social.href.startsWith('mailto:') ? undefined : 'noopener noreferrer'}
                aria-label={social.label}
              >
                <Icon name={social.icon} size={18} />
              </a>
            </li>
          ))
        }
      </ul>
      <ul class="link-row">
        {
          extras.map((link) => (
            <li>
              <a class="artifact" href={link.href} target="_blank" rel="noopener noreferrer">
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</section>

<footer class="footer">
  <div class="wrap">
    <p>© {year} {site.name}</p>
    <p>{site.location} · {site.url.replace('https://', '')}</p>
  </div>
</footer>
