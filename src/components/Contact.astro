---
import { site, contactLinks } from '../data/site';
const year = new Date().getFullYear();
---
<section class="layer contact" id="contact" aria-labelledby="contact-title">
  <p class="chrome">LAYER:05 <span>/contact</span></p>
  <div class="layer__main">
    <div class="contact__grid">
      <div class="contact__intro">
        <h2 id="contact-title">Contact</h2>
        <p class="prose">{site.contact}</p>
        <a class="contact__mail" href="mailto:21@achux.xyz">21@achux.xyz</a>
      </div>
      <ul class="directory">
        {contactLinks.map((l) => (
          <li>
            <a
              href={l.href}
              {...(l.href.startsWith('http') ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
            >
              <span>{l.label}</span>
              <span class="directory__hint">{l.hint}</span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </div>
</section>

<footer class="colophon">
  <p class="colophon__line">{site.footer}</p>
  <p class="colophon__meta">© {year} {site.name}</p>
</footer>
