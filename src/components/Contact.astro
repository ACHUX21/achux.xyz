---
import SectionHead from './SectionHead.astro';
import { site, contactLinks, hostOf } from '../data/site';
const year = new Date().getFullYear();
---
<section class="contact" id="contact" aria-labelledby="contact-title">
  <div class="contact__grid">
    <div>
      <SectionHead path="/contact" status={site.email} layer="06" headingId="contact-title">
        <a href="mailto:21@achux.xyz">21@achux.xyz</a>
      </SectionHead>
      <p>{site.contact}</p>
      <form class="mail" id="mail-form">
        <label>Name <input name="name" type="text" autocomplete="name" /></label>
        <label>Message <textarea name="message" rows="5"></textarea></label>
        <button class="btn" type="submit">Send</button>
      </form>
    </div>
    <ul class="contact__links">
      {contactLinks.map((l) => (
        <li>
          <a href={l.href} target="_blank" rel="noopener noreferrer">
            <span>{l.label}</span>
            <span class="out__host">{hostOf(l.href)}</span>
          </a>
        </li>
      ))}
    </ul>
  </div>
</section>

<script>
  const form = document.getElementById('mail-form');
  form?.addEventListener('submit', (event) => {
    event.preventDefault();
    const data = new FormData(form);
    const name = String(data.get('name') || '').trim();
    const message = String(data.get('message') || '').trim();
    const subject = name ? `From ${name}` : 'achux.xyz';
    window.location.href = `mailto:21@achux.xyz?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(message)}`;
  });
</script>

<footer class="colophon">
  <p>© {year} {site.name}</p>
</footer>
