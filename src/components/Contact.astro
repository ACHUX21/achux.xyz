---
import Protocol from './Protocol.astro';
import { site, contactLinks, hostOf } from '../data/site';
const year = new Date().getFullYear();
---
<section class="contact" id="contact" aria-labelledby="contact-title">
  <Protocol path="/contact" status={site.email} layer="04" />
  <div class="feature">
    <div class="feature__copy">
      <h2 id="contact-title">
        <a href="mailto:21@achux.xyz">21@achux.xyz</a>
      </h2>
      <p>{site.contact}</p>
      <form class="mail" id="mail-form">
        <label>Name <input name="name" type="text" autocomplete="name" /></label>
        <label>Message <textarea name="message" rows="5"></textarea></label>
        <button class="btn" type="submit">Send</button>
      </form>
    </div>
  </div>
  <ul>
    {contactLinks.map((l) => (
      <li>
        <a href={l.href} target="_blank" rel="noopener noreferrer">{l.label} <span class="out__host">{hostOf(l.href)}</span></a>
      </li>
    ))}
  </ul>
</section>

<script>
  const form = document.getElementById('mail-form');
  form?.addEventListener('submit', (event) => {
    event.preventDefault();
    const data = new FormData(form);
    const name = String(data.get('name') || '').trim();
    const message = String(data.get('message') || '').trim();
    const subject = name ? `From ${name}` : 'achux.xyz';
    window.location.href = `mailto:21@achux.xyz?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(message)}`;
  });
</script>

<footer class="colophon">
  <p class="colophon__quote">{site.quote}</p>
  <p>F1ux bio · ACHUX21 · Member</p>
  <p>© {year} {site.name}</p>
</footer>
