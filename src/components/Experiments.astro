---
import { experiments, type Experiment } from '../data/experiments';

const [lead, ...rest] = experiments;

function fields(entry: Experiment) {
  return [
    { label: 'Hypothesis', text: entry.hypothesis },
    { label: 'Method', text: entry.method },
    { label: 'Impact', text: entry.impact },
  ];
}
---

<section id="log" class="section" tabindex="-1">
  <div class="wrap">
    <header class="section-head" data-reveal>
      <p class="index"><span>02</span><i></i>Log</p>
      <h2>Experiment log</h2>
      <p class="lede">Featured work, written as a lab entry: hypothesis, method, impact, artifact.</p>
    </header>

    {
      lead && (
        <div class="tilt-scene" data-reveal>
          <article id={lead.id.toLowerCase()} class="glass lead" data-tilt="3.5">
            <div class="entry-top">
              <p class="exp-id">{lead.id}</p>
              {lead.date && <p class="exp-date">{lead.date}</p>}
            </div>
            <h3>{lead.name}</h3>
            <p class="kicker">{lead.kicker}</p>
            <ul class="chip-row">
              <li class="chip">
                Status: <em>{lead.status}</em>
              </li>
              {lead.severity && (
                <li class="chip">
                  Severity: <em>{lead.severity}</em>
                </li>
              )}
              {lead.reward && (
                <li class="chip">
                  Reward: <em>{lead.reward}</em>
                </li>
              )}
            </ul>
            <div class="fields">
              {fields(lead).map((field) => (
                <div class="field">
                  <p class="field-label">{field.label}</p>
                  <p>{field.text}</p>
                </div>
              ))}
            </div>
            <div class="artifacts">
              {lead.links.map((link) => (
                <a class="artifact" href={link.href} target="_blank" rel="noopener noreferrer">
                  {link.label}
                </a>
              ))}
            </div>
            <ul class="tags">
              {lead.tags.map((tag) => (
                <li class="chip">{tag}</li>
              ))}
            </ul>
          </article>
        </div>
      )
    }

    <div class="cards">
      {
        rest.map((entry) => (
          <div class="tilt-scene" data-reveal>
            <article id={entry.id.toLowerCase()} class="glass card" data-tilt="6">
              <div class="entry-top">
                <p class="exp-id">{entry.id}</p>
                {entry.date && <p class="exp-date">{entry.date}</p>}
              </div>
              <h3>{entry.name}</h3>
              <p class="kicker">{entry.kicker}</p>
              <ul class="chip-row">
                <li class="chip">
                  Status: <em>{entry.status}</em>
                </li>
                {entry.severity && (
                  <li class="chip">
                    Severity: <em>{entry.severity}</em>
                  </li>
                )}
              </ul>
              <div class="fields">
                {fields(entry).map((field) => (
                  <div class="field">
                    <p class="field-label">{field.label}</p>
                    <p>{field.text}</p>
                  </div>
                ))}
              </div>
              <div class="artifacts">
                {entry.links.length > 0 ? (
                  entry.links.map((link) => (
                    <a class="artifact" href={link.href} target="_blank" rel="noopener noreferrer">
                      {link.label}
                    </a>
                  ))
                ) : (
                  <span class="quiet">Private — no public artifact</span>
                )}
              </div>
              <ul class="tags">
                {entry.tags.map((tag) => (
                  <li class="chip">{tag}</li>
                ))}
              </ul>
            </article>
          </div>
        ))
      }
    </div>
  </div>
</section>
